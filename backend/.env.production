# Production Environment Configuration
NODE_ENV=production
PORT=3000

# MongoDB Configuration (Update with your production database)
MONGODB_URI=mongodb://localhost:27017/bytebrain_production

# JWT Configuration (IMPORTANT: Use strong secrets in production)
JWT_SECRET=your_super_secure_jwt_secret_key_for_production_minimum_32_characters_long
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Configure with your email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Frontend URLs (Update with your production URLs)
FRONTEND_URL=https://your-domain.com
FLUTTER_APP_URL=https://your-app-domain.com

# Security Settings
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
BASE_URL=https://your-api-domain.com

# API Keys (Update with your production keys)
GROQ_API_KEY=your_production_groq_api_key
YOUTUBE_API_KEY=your_production_youtube_api_key
LISTEN_NOTES_API_KEY=your_production_listen_notes_api_key

# Firebase Configuration (For push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account-production.json

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# Performance
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=300

# CORS Configuration
CORS_ORIGIN=https://your-domain.com,https://your-app-domain.com